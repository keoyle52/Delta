# Delta Environment Variables Template

# NextAuth App Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="delta-secret-key-change-in-production-min-32-chars"

# Database (PostgreSQL / Neon / Vercel Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delta_db?schema=public"

# Email Authentication (Resend)
RESEND_API_KEY="re_123456789_your_resend_api_key"
EMAIL_FROM="Delta <onboarding@resend.dev>"

# Circle Developer Console API (https://console.circle.com)
CIRCLE_API_KEY="TEST_API_KEY:YOUR_CIRCLE_API_KEY_HERE"
# 32-byte hex entity secret registered in Circle Developer Console (64 hex characters)
CIRCLE_ENTITY_SECRET="YOUR_REGISTERED_32_BYTE_HEX_ENTITY_SECRET_HERE"

# Circle Single App-Wide Wallet Set ID (Run npm run setup:wallet-set once to generate)
CIRCLE_WALLET_SET_ID="YOUR_CIRCLE_WALLET_SET_ID_HERE"

# Circle Kit Key for App Kit Swaps (Circle Console -> Keys -> Kit Key)
CIRCLE_KIT_KEY="KIT_KEY:YOUR_KIT_KEY_ID:YOUR_KIT_KEY_SECRET"

# Inngest Background Worker (Cloud keys for production deployment)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# Arc Network Multi-RPC Nodes (Alchemy Primary + dRPC Fallback)
ARC_RPC_PRIMARY="https://arc-testnet.g.alchemy.com/v2/4M1t80iX0CzBjHHHpcnpS"
ARC_RPC_DRPC="https://rpc.drpc.testnet.arc.network"

# Arc Ecosystem Data Indexer (Docs: https://docs.arc.io/arc/tools/data-indexers)
ENVIO_GRAPHQL_URL="https://indexer.bigindex.io/arc-testnet/graphql"

# Solana Devnet RPC (for CCTP Cross-chain Bridge)
SOLANA_RPC_URL="https://api.devnet.solana.com"
