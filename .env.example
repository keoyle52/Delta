# Delta Environment Variables Template
# Dual-Network: Arc Mainnet (#5042) & Arc Testnet (#5042002)

# NextAuth App Configuration (MUST CHANGE NEXTAUTH_SECRET IN PRODUCTION)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_min_32_char_random_string"

# Database (Neon PostgreSQL / AWS RDS)
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-dark-glade-axlrlhg1.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Privy Authentication (https://www.privy.io)
# Privy is an official Circle/Arc ecosystem partner offering passwordless auth:
NEXT_PUBLIC_PRIVY_APP_ID="clx_your_privy_app_id_here"
PRIVY_APP_SECRET="your_privy_app_secret_here"

# Optional Transactional Email Notifications (Resend)
RESEND_API_KEY="re_123456789_your_resend_api_key"
EMAIL_FROM="Delta <onboarding@resend.dev>"

# ======================================================================
# CIRCLE MAINNET CREDENTIALS (ARC MAINNET #5042)
# Required for live Mainnet operations with real USDC.
# If missing, server throws an explicit security error — silent fallback to testnet is prohibited.
# ======================================================================
CIRCLE_MAINNET_API_KEY="LIVE_API_KEY:YOUR_MAINNET_API_KEY_HERE"
CIRCLE_MAINNET_ENTITY_SECRET="YOUR_REGISTERED_MAINNET_32_BYTE_HEX_ENTITY_SECRET_HERE"
CIRCLE_MAINNET_WALLET_SET_ID="YOUR_MAINNET_WALLET_SET_ID_HERE"
CIRCLE_MAINNET_KIT_KEY="KIT_KEY:YOUR_MAINNET_KIT_KEY_ID:YOUR_MAINNET_KIT_KEY_SECRET"

# ======================================================================
# CIRCLE TESTNET CREDENTIALS (ARC TESTNET #5042002)
# Used when active network is set to Testnet.
# ======================================================================
CIRCLE_TESTNET_API_KEY="TEST_API_KEY:YOUR_TESTNET_API_KEY_HERE"
CIRCLE_TESTNET_ENTITY_SECRET="YOUR_REGISTERED_TESTNET_32_BYTE_HEX_ENTITY_SECRET_HERE"
CIRCLE_TESTNET_WALLET_SET_ID="YOUR_TESTNET_WALLET_SET_ID_HERE"
CIRCLE_TESTNET_KIT_KEY="KIT_KEY:YOUR_TESTNET_KIT_KEY_ID:YOUR_TESTNET_KIT_KEY_SECRET"

# Legacy fallback testnet variables (also supported for testnet):
# CIRCLE_API_KEY="TEST_API_KEY:..."
# CIRCLE_ENTITY_SECRET="..."
# CIRCLE_WALLET_SET_ID="..."
# CIRCLE_KIT_KEY="KIT_KEY:..."

# Inngest Background Worker (Cloud keys for production deployment)
INNGEST_EVENT_KEY="your-inngest-event-key"
INNGEST_SIGNING_KEY="your-inngest-signing-key"

# Solana RPC (Mainnet & Devnet)
SOLANA_MAINNET_RPC_URL="https://api.mainnet-beta.solana.com"
SOLANA_RPC_URL="https://api.devnet.solana.com"
