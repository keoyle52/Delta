generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  password      String?
  otpCode       String?
  otpExpires    DateTime?
  isSimulated   Boolean    @default(false)
  activeNetwork String     @default("mainnet")
  createdAt     DateTime   @default(now())
  wallets       Wallet[]
  workflows     Workflow[]
}

model Wallet {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  circleWalletId       String   @unique
  circleWalletSetId    String
  address              String   @unique
  blockchain           String   @default("ARC")
  network              String   @default("mainnet")
  isSimulated          Boolean  @default(false)
  simulatedUsdcBalance String   @default("0")
  simulatedEurcBalance String   @default("0")
  createdAt            DateTime @default(now())

  @@unique([userId, network])
  @@index([userId, network])
}

model Workflow {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  network    String      @default("mainnet")
  isActive   Boolean     @default(true)
  nodes      Json        // React Flow nodes JSON array
  edges      Json        // React Flow edges JSON array
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  executions Execution[]

  @@index([userId, network])
}

model Execution {
  id            String    @id @default(cuid())
  workflowId    String
  workflow      Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  network       String    @default("mainnet")
  triggerTxHash String
  triggerAmount String    // USDC amount string for precision
  status        String    // PENDING | RUNNING | COMPLETE | FAILED
  stepLogs      Json      // Array of step logs JSON
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([workflowId, network])
}
